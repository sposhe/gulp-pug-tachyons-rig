extends ../templates/root.pug

append variables
  - const path = ''
  - const url = baseurl + path
  - const title = 'Page Title'
  - const description = 'Page description goes here.'
  - const type = 'website'
  - const image = baseurl + 'og.png'
  - const imageWidth = 400
  - const imageHeight = 600
  - const imageAlt = 'Description of OpenGraph image.'

block json
  at-context http://schema.org
  at-graph
    at-type WebSite
    at-id= baseurl + path +'#WebSite'
    url= baseurl
  at-graph
    at-type WebPage
    at-id= baseurl + path + '#WebPage'
    url= baseurl + path
    description= description


block content
  main#main
    header
      h1 Page Title
